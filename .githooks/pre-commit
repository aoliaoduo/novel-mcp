#!/bin/sh
set -eu

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "privacy gate: Python is required to run scripts/public-audit.py" >&2
  exit 1
fi

"$PYTHON" scripts/public-audit.py

for role in AUTHOR COMMITTER; do
  if [ "$role" = AUTHOR ]; then
    ident=$(git var GIT_AUTHOR_IDENT)
  else
    ident=$(git var GIT_COMMITTER_IDENT)
  fi
  email=$(printf '%s\n' "$ident" | sed -n 's/.*<\([^>]*\)>.*/\1/p')
  case "$email" in
    *@users.noreply.github.com)
      ;;
    *)
      echo "privacy gate: refusing commit with a non-GitHub-noreply $role email." >&2
      echo "privacy gate: configure a repository-local GitHub noreply email first." >&2
      exit 1
      ;;
  esac
done
